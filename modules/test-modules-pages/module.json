          "type": "enum",
          "required": true,
          "options": [
            "active",
            "disabled"
          ],
          "defaultValue": "active"
        },
        {
          "id": "reason",
          "label": "Reason",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 500
        },
        {
          "id": "createdOn",
          "label": "Created On",
          "type": "text",
          "required": true,
          "minLength": 10,
          "maxLength": 40
        },
        {
          "id": "updatedOn",
          "label": "Updated On",
          "type": "text",
          "required": true,
          "minLength": 10,
          "maxLength": 40
        }
      ],
