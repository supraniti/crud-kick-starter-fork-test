          "label": "Published On",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 40
        },
        {
          "id": "archivedOn",
          "label": "Archived On",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 40
