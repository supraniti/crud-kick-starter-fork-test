{
  "contractVersion": 1,
  "id": "test-modules-translations",
  "version": "0.1.0",
  "name": "Test Modules Translations",
  "capabilities": [
    "crud.collection",
    "schema",
    "ui.route"
  ],
  "lifecycle": {
    "install": "test-modules-translations.install",
    "uninstall": "test-modules-translations.uninstall"
  },
  "runtime": {
    "collectionHandlers": "./server/collection-handlers.mjs",
    "persistence": "./server/persistence-plugins.mjs",
    "routes": "./server/routes.mjs"
  },
  "ui": {
    "navigation": {
      "label": "Translations",
      "icon": "translate",
      "order": 518,
      "routeSegment": "translations"
    },
    "routeView": {
      "kind": "custom",
      "entrypoint": "./frontend/view-entrypoint.jsx"
    }
  },
  "collections": [
    {
      "id": "translation-units",
      "label": "Translation Units",
      "entitySingular": "translation-unit",
      "primaryField": "entityLabel",
      "description": "Field-level translation entries for authored content and layout widget text.",
      "capabilities": {
        "list": true,
        "read": true,
        "create": true,
        "update": true,
        "delete": true
      },
      "fields": [
        { "id": "entityType", "label": "Entity Type", "type": "text", "required": true, "minLength": 3, "maxLength": 80 },
        { "id": "entityId", "label": "Entity ID", "type": "text", "required": true, "minLength": 2, "maxLength": 120 },
        { "id": "fieldPath", "label": "Field Path", "type": "text", "required": true, "minLength": 1, "maxLength": 400 },
        { "id": "fieldLabel", "label": "Field Label", "type": "text", "required": true, "minLength": 1, "maxLength": 200 },
        { "id": "entityLabel", "label": "Entity Label", "type": "text", "required": true, "minLength": 1, "maxLength": 240 },
        { "id": "sourceLocale", "label": "Source Locale", "type": "text", "required": true, "minLength": 2, "maxLength": 16 },
        { "id": "sourceValue", "label": "Source Value", "type": "text", "required": true, "minLength": 0, "maxLength": 200000 },
        { "id": "valueKind", "label": "Value Kind", "type": "enum", "required": true, "options": ["text", "rich-text"], "defaultValue": "text" },
        { "id": "translationsJson", "label": "Translations JSON", "type": "text", "required": true, "minLength": 2, "maxLength": 200000 },
        { "id": "createdOn", "label": "Created On", "type": "text", "required": true, "minLength": 10, "maxLength": 40 },
        { "id": "updatedOn", "label": "Updated On", "type": "text", "required": true, "minLength": 10, "maxLength": 40 }
      ],
      "behavior": {
        "enforcePrimaryFieldUnique": false,
        "enforceTitleUnique": false,
        "requirePublishedOnWhenPublished": false
      }
    }
  ],
  "metadata": {
    "owner": "reference-domain-runtime",
    "maturity": "proof",
    "ticket": "translations-module-introduction"
  }
}
