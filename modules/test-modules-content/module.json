      "fields": [
        {
          "id": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "minLength": 5,
          "maxLength": 180
        },
        {
          "id": "slug",
          "label": "Slug",
          "type": "computed",
          "required": false,
          "source": "title",
          "resolver": "slugify",
          "transform": "slugify"
        },
        {
          "id": "subtitle",
          "label": "Subtitle",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 220
