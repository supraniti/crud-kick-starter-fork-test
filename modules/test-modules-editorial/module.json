{
  "contractVersion": 1,
  "id": "test-modules-editorial",
  "version": "0.1.0",
  "name": "Test Modules Editorial",
  "capabilities": [
    "crud.collection",
    "schema",
    "ui.route"
  ],
  "lifecycle": {
    "install": "test-modules-editorial.install",
    "uninstall": "test-modules-editorial.uninstall"
  },
  "runtime": {
    "collectionHandlers": "./server/collection-handlers.mjs",
    "persistence": "./server/persistence-plugins.mjs"
  },
  "ui": {
    "navigation": {
      "label": "Editorial",
      "icon": "edit_note",
      "order": 470
    },
    "routeView": {
      "kind": "custom",
      "entrypoint": "./frontend/view-entrypoint.jsx"
    }
  },
  "collections": [
    {
      "id": "blog-authors",
      "label": "Authors",
      "entitySingular": "author",
      "primaryField": "displayName",
      "description": "Author profiles and editorial ownership metadata for the blog-management module set.",
      "capabilities": {
        "list": true,
        "read": true,
        "create": true,
        "update": true,
        "delete": true
      },
      "fields": [
        {
          "id": "displayName",
          "label": "Display Name",
          "type": "text",
          "required": true,
          "minLength": 2,
          "maxLength": 120
        },
        {
          "id": "slug",
          "label": "Slug",
          "type": "computed",
          "required": false,
          "source": "displayName",
          "resolver": "slugify",
          "transform": "slugify"
        },
        {
          "id": "legalName",
          "label": "Legal Name",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 160
        },
        {
          "id": "bio",
          "label": "Bio",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 5000
        },
        {
          "id": "avatarMediaId",
          "label": "Avatar Media",
          "type": "reference",
          "required": false,
          "collectionId": "media-items",
          "labelField": "displayName",
          "onDelete": "nullify"
        },
        {
          "id": "email",
          "label": "Email",
          "type": "text",
          "required": true,
          "minLength": 5,
          "maxLength": 240
        },
        {
          "id": "websiteUrl",
          "label": "Website URL",
          "type": "url",
          "required": false,
          "minLength": 0,
          "maxLength": 320
        },
        {
          "id": "socialLinks",
          "label": "Social Links",
          "type": "structured-object",
          "required": false,
          "constraints": {
            "objectSchema": {
              "properties": [
                {
                  "id": "x",
                  "label": "X",
                  "type": "text",
                  "required": false,
                  "minLength": 0,
                  "maxLength": 240
                },
                {
                  "id": "linkedin",
                  "label": "LinkedIn",
                  "type": "text",
                  "required": false,
                  "minLength": 0,
                  "maxLength": 240
                },
                {
                  "id": "github",
                  "label": "GitHub",
                  "type": "text",
                  "required": false,
                  "minLength": 0,
                  "maxLength": 240
                }
              ]
            }
          }
        },
        {
          "id": "role",
          "label": "Role",
          "type": "enum",
          "required": true,
          "options": [
            "author",
            "editor",
            "managing-editor",
            "guest"
          ],
          "defaultValue": "author"
        },
        {
          "id": "status",
          "label": "Status",
          "type": "enum",
          "required": true,
          "options": [
            "active",
            "inactive",
            "blocked"
          ],
          "defaultValue": "active"
        },
        {
          "id": "locale",
          "label": "Locale",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 16
        },
        {
          "id": "expertiseTagIds",
          "label": "Expertise Tags",
          "type": "reference-multi",
          "required": false,
          "collectionId": "blog-tags",
          "labelField": "name",
          "onDelete": "nullify",
          "defaultValue": []
        },
        {
          "id": "createdOn",
          "label": "Created On",
          "type": "text",
          "required": true,
          "minLength": 10,
          "maxLength": 40
        },
        {
          "id": "updatedOn",
          "label": "Updated On",
          "type": "text",
          "required": true,
          "minLength": 10,
          "maxLength": 40
        },
        {
          "id": "lastPublishedOn",
          "label": "Last Published On",
          "type": "text",
          "required": false,
          "minLength": 0,
          "maxLength": 40
        }
      ],
      "behavior": {
        "enforcePrimaryFieldUnique": false,
        "enforceTitleUnique": false,
        "requirePublishedOnWhenPublished": false
      }
    }
  ],
  "metadata": {
    "owner": "reference-domain-runtime",
    "maturity": "proof",
    "ticket": "current-capability-module-realignment"
  }
}

